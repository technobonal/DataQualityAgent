# ============================================================
# DataQualityAgent — Variables de entorno
# ============================================================
# IMPORTANTE: este archivo NUNCA se sube a git (ya está en .gitignore).
# Completá cada valor con tu propia API key, sin comillas.

# --- Groq (LLM principal, vía litellm) ---
# Se consigue gratis en: https://console.groq.com/keys
GROQ_API_KEY=

# --- Cohere (embeddings para el RAG, embed-multilingual-v3.0) ---
# Se consigue gratis (con límites) en: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# --- Hugging Face (fallback de Groq + detección de datos sensibles) ---
# Se consigue en: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# --- Configuración general de la app ---
# llama-3.3-70b-versatile: 12.000 tokens/min en el free tier — más margen
# que openai/gpt-oss-20b (8.000 tokens/min), importante porque este agente
# manda 15 tool schemas en cada llamada.
GROQ_MODEL=llama-3.3-70b-versatile

# Modelo de respaldo en Hugging Face si Groq falla (vía Together AI)
HF_FALLBACK_MODEL=huggingface/together/meta-llama/Llama-3.3-70B-Instruct

# Carpeta donde persiste la base de Chroma (vector store del RAG)
CHROMA_DB_PATH=./chroma_db

# Nivel de logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO